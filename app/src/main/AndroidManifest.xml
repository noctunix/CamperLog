<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Standort auf Tastendruck; im Hintergrund nur bei eingeschalteter Trackaufzeichnung über den
         sichtbaren Vordergrunddienst unten. Kein ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Genutzt nur bei eingeschaltetem „Wetter & Karte“. Offline wird am fehlgeschlagenen Request
         erkannt, daher kein ACCESS_NETWORK_STATE. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nur abgefragt, wenn Benachrichtigungen eingeschaltet werden. Der tägliche Check ist ein
         periodischer WorkManager-Job ohne exakte Alarme; WAKE_LOCK und RECEIVE_BOOT_COMPLETED bringt
         WorkManager dafür selbst mit. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nur für die eingeschaltete Trackaufzeichnung: ein aus der App gestarteter Vordergrunddienst
         mit sichtbarer Benachrichtigung; weiterhin kein ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- WorkManager deklariert dies nur für Netzwerk-Constraints; der Check nutzt keine, und die
         Berechtigungsliste soll nichts Ungenutztes zeigen. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".CamperLogApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CamperLog">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared locations from map apps start a new stop with the type picker. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.TrackRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
