    <!-- Keep Android Open -->
    <string name="title_keep_android_open">Android\'s openness is under threat</string>
    <string name="body_keep_android_open">Google plans to require every Android app — including ones installed outside the Play Store, like this one — to come from a verified developer identity, starting in 2026. Without that verification, devices will refuse to install apps at all.\n\nThis would hit F-Droid especially hard: an independent, sideloadable app store like F-Droid may no longer be able to exist in its current form, and continued maintenance of CamperLog outside Google\'s control could become impossible.\n\nThe \"Keep Android Open\" campaign is fighting these plans.</string>
    <string name="btn_keep_android_open_link">Open keepandroidopen.org</string>
